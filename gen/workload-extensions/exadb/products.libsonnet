        'com.oraclecloud.databaseservice.changeexadatainfrastructurecompartment',
        'com.oraclecloud.databaseservice.deleteexadatainfrastructure.begin',
        'com.oraclecloud.databaseservice.deleteexadatainfrastructure.end',
