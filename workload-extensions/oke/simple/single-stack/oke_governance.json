{
    "tags_configuration": {
        "default_compartment_id"              : "TENANCY-ROOT",

        "namespaces": {
            "TAGNS-LZ-COST-GOVERNANCE-KEY": {
                "name"                        : "tagns-lz-cost-governance",
                "description"                 : "Cost governance tags for FinOps reporting.",
                "is_retired"                  : false,

                "tags": {
                    "TAG-LZ-BUSINESS-UNIT-KEY": {
                        "name"                : "tag-lz-business-unit",
                        "description"         : "Business unit responsible for the resource.",
                        "is_cost_tracking"    : false,
                        "is_retired"          : false,

                        "valid_values": [
                            "tobedefined",
                            "IT",
                            "Finance",
                            "Digital",
                            "Retail"
                        ]
                    },

                    "TAG-LZ-COST-CENTER-KEY": {
                        "name"                : "tag-lz-cost-center",
                        "description"         : "Cost center responsible for the resource.",
                        "is_cost_tracking"    : false,
                        "is_retired"          : false,
                        "valid_values"        : ["tobedefined", "CC12345"]
                    },

                    "TAG-LZ-ENVIRONMENT-KEY": {
                        "name"                : "tag-lz-environment",
                        "description"         : "Deployment environment associated with the resource.",
                        "is_cost_tracking"    : false,
                        "is_retired"          : false,

                        "valid_values": [
                            "dev",
                            "preprod",
                            "prod",
                            "shared",
                            "staging",
                            "test",
                            "tobedefined",
                            "uat"
                        ]
                    },

                    "TAG-LZ-OWNER-KEY": {
                        "name"                : "tag-lz-owner",
                        "description"         : "Person or team accountable for the resource.",
                        "is_cost_tracking"    : false,
                        "is_retired"          : false,
                        "valid_values"        : ["tobedefined", "email.address@example.com"]
                    },

                    "TAG-LZ-PLATFORM-KEY": {
                        "name"                : "tag-lz-platform",
                        "description"         : "Platform associated with the resource.",
                        "is_cost_tracking"    : false,
                        "is_retired"          : false,

                        "valid_values": [
                            "tobedefined",
                            "network",
                            "security",
                            "observability",
                            "oke",
                            "ocvs",
                            "exacs",
                            "exacc",
                            "ebs",
                            "hpc",
                            "finops",
                            "ai-services"
                        ]
                    },

                    "TAG-LZ-PROJECT-KEY": {
                        "name"                : "tag-lz-project",
                        "description"         : "Project associated with the resource.",
                        "is_cost_tracking"    : false,
                        "is_retired"          : false,

                        "valid_values": [
                            "notapply",
                            "proj1",
                            "proj2"
                        ]
                    }
                }
            },

            "TAGNS-LZ-OKE-KEY": {
                "name"                        : "tagns-lz-oke",
                "description"                 : "Landing Zone-owned tag that isolates OKE platforms.",
                "is_retired"                  : false,

                "tags": {
                    "TAG-LZ-OKE-PLATFORM-KEY": {
                        "name"                : "platform",
                        "description"         : "Identifies the owning OKE platform for principal-to-resource tag matching.",
                        "is_cost_tracking"    : false,
                        "is_retired"          : false
                    }
                }
            },

            "TAGNS-LZ-ROLE-KEY": {
                "name"                        : "tagns-lz-role",
                "description"                 : "Tag namespace for Tag Based Access Controls of Landing Zone Roles.",
                "is_retired"                  : false,

                "tags": {
                    "TAG-LZ-ROLE-KEY": {
                        "name"                : "tag-lz-role",
                        "description"         : "Tag used to identify different administrative roles within the Landing Zone, across network and security compartments",
                        "is_cost_tracking"    : false,
                        "is_retired"          : false
                    }
                }
            }
