{
    "alarms_configuration": {
        "default_compartment_id"                          : "CMP-LZ-NETWORK-KEY",

        "alarms": {
            "AL-LZ-AUDIT-CONNECTOR-INTERNAL-ERRORS-KEY": {
                "display_name"                            : "al-lz-audit-connector-internal-errors",
                "destination_topic_ids"                   : ["NOTT-LZ-SECURITY-KEY"],
                "is_enabled"                              : false,

                "supplied_alarm": {
                    "message_format"                      : "PRETTY_JSON",
                    "metric_compartment_id"               : "CMP-LZ-SECURITY-KEY",
                    "namespace"                           : "oci_service_connector_hub",
                    "pending_duration"                    : "PT15M",
                    "query"                               : "ServiceConnectorHubErrors[5m].groupBy(connectorId).sum() > 0",
                    "severity"                            : "CRITICAL"
                }
            },

            "AL-LZ-AUDIT-CONNECTOR-SOURCE-ERRORS-KEY": {
                "display_name"                            : "al-lz-audit-connector-source-errors",
                "destination_topic_ids"                   : ["NOTT-LZ-SECURITY-KEY"],
