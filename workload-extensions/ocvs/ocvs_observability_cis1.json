                "supplied_alarm": {
                    "message_format"                      : "PRETTY_JSON",
                    "metric_compartment_id"               : "CMP-LZ-SECURITY-KEY",
                    "namespace"                           : "oci_service_connector_hub",
                    "pending_duration"                    : "PT30M",
                    "query"                               : "ErrorsAtSource[15m].groupBy(errorCode,connectorId).min() > 0",
                    "severity"                            : "WARNING"
                }
            },

            "AL-LZ-AUDIT-CONNECTOR-STALE-KEY": {
                "display_name"                            : "al-lz-audit-connector-stale",
                "destination_topic_ids"                   : ["NOTT-LZ-SECURITY-KEY"],
