{
    "network_configuration": {
        "default_enable_cis_checks"                                  : false,

        "network_configuration_categories": {
            "Add_Project_DBM_OPSI_NSGs": {
                "inject_into_existing_vcns": {
                    "VCN-FRA-LZ-PREPROD-PROJECTS-KEY": {
                        "vcn_id"                                     : "VCN-FRA-LZ-PREPROD-PROJECTS-KEY",

                        "network_security_groups": {
                            "NSG-FRA-LZ-PREPROD-PROJ1-MON-PE-DB1-KEY": {
                                "display_name"                       : "nsg-fra-lz-preprod-proj1-mon-pe-db1",
                                "compartment_id"                     : "CMP-LZ-PREPROD-PROJ1-KEY",

                                "ingress_rules": {
                                    "ingress_project_database_subnet": {
                                        "description"                : "Allow communication between project DBM/OPSI PEs and the DBCS database listener in the Preprod DB subnet",
                                        "src"                        : "10.0.130.0/24",
                                        "src_type"                   : "CIDR_BLOCK",
                                        "dst_port_min"               : 1521,
                                        "dst_port_max"               : 1521,
                                        "protocol"                   : "TCP",
                                        "stateless"                  : false
                                    }
                                },

                                "egress_rules": {
                                    "anywhere": {
                                        "description"                : "Egress to 0.0.0.0/0 over TCP",
                                        "dst"                        : "0.0.0.0/0",
                                        "dst_type"                   : "CIDR_BLOCK",
                                        "protocol"                   : "TCP",
                                        "stateless"                  : false
                                    }
                                }
                            }
                        }
                    },

                    "VCN-FRA-LZ-PROD-PROJECTS-KEY": {
                        "vcn_id"                                     : "VCN-FRA-LZ-PROD-PROJECTS-KEY",

                        "network_security_groups": {
                            "NSG-FRA-LZ-PROD-PROJ1-MON-PE-DB1-KEY": {
                                "display_name"                       : "nsg-fra-lz-prod-proj1-mon-pe-db1",
                                "compartment_id"                     : "CMP-LZ-PROD-PROJ1-KEY",

                                "ingress_rules": {
                                    "ingress_project_database_subnet": {
                                        "description"                : "Allow communication between project DBM/OPSI PEs and the DBCS database listener in the Prod DB subnet",
                                        "src"                        : "10.0.66.0/24",
                                        "src_type"                   : "CIDR_BLOCK",
                                        "dst_port_min"               : 1521,
                                        "dst_port_max"               : 1521,
                                        "protocol"                   : "TCP",
                                        "stateless"                  : false
                                    }
                                },

                                "egress_rules": {
                                    "anywhere": {
                                        "description"                : "Egress to 0.0.0.0/0 over TCP",
                                        "dst"                        : "0.0.0.0/0",
                                        "dst_type"                   : "CIDR_BLOCK",
                                        "protocol"                   : "TCP",
                                        "stateless"                  : false
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
