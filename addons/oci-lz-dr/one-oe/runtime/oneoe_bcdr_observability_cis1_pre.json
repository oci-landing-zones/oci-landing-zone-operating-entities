        "default_compartment_id"                 : "CMP-LZ-NETWORK-KEY",

        "alarms": {
            "AL-AMS-LZ-NETWORK-LB-KEY": {
                "display_name"                   : "al-ams-lz-network-lb",
                "destination_topic_ids"          : ["NOTT-AMS-LZ-NETWORK-KEY"],
                "is_enabled"                     : "false",

                "supplied_alarm": {
                    "message_format"             : "PRETTY_JSON",
                    "namespace"                  : "oci_lbaas",
                    "pending_duration"           : "PT5M",
                    "query"                      : "UnHealthyBackendServers[1m].mean() >= 0"
                }
            }
        }
    },

