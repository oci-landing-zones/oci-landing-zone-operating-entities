                "compartment_id"                         : "TENANCY-ROOT",

                "statements": [
                    "define tenancy reporting as ocid1.tenancy.oc1..aaaaaaaaned4fkpkisbwjlr56u7cj63lf3wffbilvqknstgtvzub7vhqkggq",
